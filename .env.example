# ── 로컬 개발용 (.env — 커밋 금지) ─────────────────────────────
# 로컬 자동화(Jira 조회, 에이전트의 GitLab API 작업)에 필요한 키.
# 루트에 .env 파일을 만들어 실제 값을 넣는다. 실행: node --env-file=.env ...
#
# JIRA_EMAIL=       Atlassian 계정 이메일
# JIRA_API_TOKEN=   id.atlassian.com → Security → API tokens에서 발급 (조회 용도 — 이슈 생성은 월요일 팀 회의에서 수동)
# GITLAB_TOKEN=     본인 GitLab User Settings → Access Tokens에서 발급한 Personal Access Token(api scope).
#                   MR 작성자를 본인 계정으로 표시하려면 project access token(bot)을 사용하지 않는다.

# ── 인증 토큰 설정 (backend/docs/auth-session-guide.md) ──────
# 로컬 실제 키는 .gitignore 대상 .secrets/ 아래에 생성하고 커밋하지 않는다.
#
# 운영은 이 파일(Jenkins credential prod-env-file)로 전달하지 않는다. 2026-09-11부터
# 서버의 /home/ubuntu/.secrets/prod 를 컨테이너 /run/secrets 에 읽기 전용으로 붙이고
# 그 안의 prod.yml 을 SPRING_CONFIG_ADDITIONAL_LOCATION 으로 읽는다. 생성은
# infra/scripts/setup-prod-secrets.py. 정책 고정값(TTL·issuer 등)만 compose.prod.yml
# 리터럴이다. 자세한 것은 docs/deploy-guide.md "운영 기동에 필요한 설정".
# 여기에 운영 값을 추가하면 OS 환경변수가 prod.yml 보다 우선해 덮어쓰므로 넣지 않는다.
#
# REDIS_CREDENTIALS_PATH 는 비밀번호를 전달하지 못한다. Spring Boot 는
# spring.data.redis.url 이 있으면 password 를 URL 에서만 읽고 별도 password 속성을
# 무시하는데, application.yml 이 url 에 기본값을 주므로 url 은 항상 설정된 상태다.
# 운영은 SPRING_DATA_REDIS_URL 에 비밀번호를 포함해 prod.yml 에 둔다.
# 로컬 개발도 같은 영향을 받는다 (docs/deploy-guide.md "Redis" 절).
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P30D
AUTH_JWT_CLOCK_SKEW=PT30S
AUTH_JWT_ISSUER=meonggocuisine-auth
AUTH_JWT_AUDIENCE=meonggocuisine-api
AUTH_JWT_CLIENT_ID=meonggocuisine-android
AUTH_JWT_ACTIVE_KID=local-dev-v1
AUTH_JWT_PRIVATE_KEY_PATH=.secrets/jwt/private-key.pem
AUTH_JWT_PUBLIC_JWKS_PATH=.secrets/jwt/public-jwks.json

# ── 비밀번호 계약 (가입 구현: backend/docs/member-signup-guide.md) ──
# 길이·Argon2 비용·본문 상한은 코드의 고정 정책이다. 환경변수로 낮출 수 없다.
# 실행권·HMAC 키·trusted proxy 설정은 실행 환경에서 읽는다. 실패 제한 수치는 고정 정책이다.
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=64
AUTH_PASSWORD_ARGON2_MEMORY_KIB=65536
AUTH_PASSWORD_ARGON2_ITERATIONS=3
AUTH_PASSWORD_ARGON2_PARALLELISM=4
AUTH_PASSWORD_ARGON2_SALT_BYTES=16
AUTH_PASSWORD_ARGON2_HASH_BYTES=32
AUTH_ARGON2_MAX_CONCURRENCY=4
AUTH_REQUEST_MAX_BODY_BYTES=8192
AUTH_INPUT_PRE_NORMALIZATION_MAX_CODE_POINTS=256
AUTH_LOGIN_ACCOUNT_FAILURE_WINDOW=PT15M
AUTH_LOGIN_ACCOUNT_FAILURE_LIMIT=5
AUTH_LOGIN_IP_FAILURE_WINDOW=PT10M
AUTH_LOGIN_IP_FAILURE_LIMIT=20
AUTH_LOGIN_BLOCK_TTL=PT15M
# CSPRNG로 생성한 서로 다른 최소 32바이트 key의 Base64. 실제 값 커밋 금지.
AUTH_LOGIN_ID_HMAC_KEY_V1=
AUTH_IP_HMAC_KEY_V1=
# 쉼표로 구분한 trusted reverse proxy CIDR. 직접 연결 환경은 빈 값 유지.
AUTH_TRUSTED_PROXY_CIDRS=

# ── 휴대전화 인증·개인정보 보호 계약 ──────────────────────────
# TTL·rate 상수·개인정보 버전은 코드에서 고정하며 아래 값은 정책 설명이다.
PHONE_OTP_TTL=PT3M
PHONE_PROOF_TTL=PT10M
PHONE_RESEND_COOLDOWN=PT60S
PHONE_SEND_PHONE_HOURLY_LIMIT=5
PHONE_SEND_PHONE_DAILY_LIMIT=10
PHONE_SEND_IP_HOURLY_LIMIT=20
PHONE_OTP_VERIFY_FAILURE_LIMIT=5
PHONE_OTP_HMAC_KEY_V1=
PHONE_LOOKUP_HMAC_KEY_V1=
PRIVACY_COLLECTION_POLICY_VERSION=privacy-collection-v1
EXACT_LOCATION_DISCLOSURE_POLICY_VERSION=exact-location-v1

# AES-256-GCM keyring 파일. Base64 32바이트 키 원문을 env에 직접 넣지 않는다.
# 형식: {"currentKid":"V1","keys":{"V1":"<Base64 32 bytes>"}}
PHONE_DATA_ENCRYPTION_KEYRING_PATH=.secrets/encryption/phone-keyring.json
LOCATION_DATA_ENCRYPTION_KEYRING_PATH=.secrets/encryption/location-keyring.json

# 앱 버전 안내 (V1). 0 이면 안내 없음. 운영 값은 compose.prod.yml 이 릴리즈마다 든다.
APP_ANDROID_LATEST_VERSION_CODE=0
APP_ANDROID_MIN_VERSION_CODE=0
APP_ANDROID_STORE_URL=https://m.onestore.co.kr/v2/ko-kr/app/0001009297

# 운영은 SOLAPI, local/test는 FAKE. 운영 프로필에서 FAKE 기동 금지.
# FAKE에서는 가입 요청의 011-0000-0000만 인증 증명 없이 허용한다.
SMS_PROVIDER=FAKE
SMS_FAKE_FIXED_OTP=000000
SOLAPI_CREDENTIALS_PATH=.secrets/solapi/credentials.properties
# SOLAPI 파일 속성: apiKey, apiSecret, senderNumber (등록된 숫자 발신번호)

# ── 매칭 요청 모델 스냅샷 (ai/model.yaml과 함께 변경) ─────────
MATCH_MODEL_ID=dinov2_vitb14
MATCH_MODEL_VERSION=v2

# 외부 publish 금지. 운영 자격증명·TLS는 배포 Secret으로 주입한다.
SPRING_DATA_REDIS_URL=redis://localhost:6379
REDIS_CREDENTIALS_PATH=.secrets/redis/credentials.properties
# Redis 파일 속성: spring.data.redis.username(선택), spring.data.redis.password

# ── 게시물 등록 ─────────────────────────────────────────
# 아래 세 제한은 API 계약 상수의 참고값이며 환경변수로 바뀌지 않는다.
POST_METADATA_MAX_BYTES=65536
POST_EXACT_LOCATION_MAX_CODE_POINTS=200
POST_FEATURE_TEXT_MAX_CODE_POINTS=2000
# 승인된 공식 CSV를 별도 준비한다. 형식·checksum: backend/docs/post-creation-guide.md
REGION_CODE_DATA_PATH=.secrets/reference/region-codes.csv
REGION_CODE_DATA_VERSION=
REGION_CODE_DATA_SHA256=
# 프로세스별 사진 쓰기 동시 실행 수(1~4). 증가 전 실제 서버 메모리 부하 검증 필수.
PHOTO_UPLOAD_MAX_CONCURRENCY=1
# ── 후속 비동기·파기 작업 계약 (미연결) ──────────────────
MATCH_RUNNING_STALE_AFTER=PT5M
MATCH_HARD_TIMEOUT=PT60S
SHELTER_DATA_DELAYED_AFTER=PT36H
MEMBER_ERASURE_CRON="0 30 3 * * *"
MEMBER_ERASURE_BATCH_SIZE=100
SECURITY_LOG_RETENTION=P30D
HDFS_URI=hdfs://bd-master:9000

# DATA 공공동물 PostgreSQL 적재기. 실제 DSN은 배포 Secret으로만 주입한다.
SHELTER_POSTGRES_DSN=

# FCM 일일 입소 요약·개인 채팅 알림. service account JSON과 개인 토큰 보호 키링은
# Jenkins Secret file로 read-only mount한다. Firebase 프로젝트·Android 수신 검증 전에는
# 각 발송 기능을 활성화하지 않는다.
FCM_DAILY_SUMMARY_ENABLED=false
FCM_CHAT_ENABLED=false
# 컨테이너 안의 read-only mount 경로. 호스트 Secret 파일 경로와 혼동하지 않는다.
FCM_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FCM_PROJECT_ID=
FCM_DAILY_SUMMARY_POLL_INTERVAL=PT1M
FCM_CHAT_POLL_INTERVAL=PT5S
FCM_CHAT_LEASE_DURATION=PT30S
FCM_SEND_TIMEOUT=PT10S
# 형식: {"currentKid":"V1","keys":{"V1":"<Base64 32 bytes>"}}
# 교체 중에는 현재·직전 키 두 개까지만 두고, 쓰기는 currentKid만 사용한다.
FCM_TOKEN_ENCRYPTION_KEYRING_PATH=.secrets/encryption/fcm-token-keyring.json
# 암호화 키와 다른 최소 32바이트 HMAC 키의 Base64. 실제 값 커밋 금지.
FCM_TOKEN_LOOKUP_HMAC_KEY_V1=

# 온디맨드 매칭 DATA worker. DSN·인증정보는 배포 Secret으로만 주입한다.
MATCH_WORKER_POSTGRES_DSN=
# 장기 실행 DATA/AI 매칭 엔진의 내부 HTTP endpoint. URL에 자격증명을 넣지 않는다.
MATCH_ENGINE_URL=

# ── 사용자 사진 WebHDFS (세 접속값 모두 설정해야 사진 기능 사용 가능) ──
# 내부 origin만 허용. DataNode redirect origin을 빠짐없이 쉼표로 나열한다.
PHOTO_HDFS_NAMENODE_URL=
PHOTO_HDFS_DATANODE_URLS=
PHOTO_HDFS_USER=
# 실제 HDFS 접속·권한 검증 후 true로 설정한다.
PHOTO_CLEANUP_ENABLED=false
PHOTO_CLEANUP_CRON="0 0 4 * * *"
MEMBER_PHOTO_ERASURE_POLL_INTERVAL=PT1M

# ── 운영 배포용 (Jenkins Secret file: prod-env-file) ───────────
# 아래 키들은 compose.prod.yml이 사용한다. 실제 값을 채운 파일은 절대
# 커밋하지 않는다. 로컬 개발 DB는 compose.dev.yml의 기본값을 쓴다.

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# 배포 이미지 태그 — Jenkins가 BUILD_NUMBER로 덮어쓴다.
# 롤백 시 이전 빌드 번호를 지정해 재기동한다 (docs/deploy-guide.md).
IMAGE_TAG=latest
