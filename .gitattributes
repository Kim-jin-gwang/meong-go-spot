# Normalize text files in the repository.
* text=auto eol=lf

# Windows command scripts require CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep common binary assets untouched.
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.jar binary
*.war binary
*.7z binary

# Avoid textual diffs for office and design artifacts.
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary
*.fig binary

# 고정 비밀번호 데이터는 checksum으로 검증한다. 10만 줄을 코드·AI 리뷰 diff에 펼치지 않는다.
backend/src/main/resources/security/password-blocklist/pwdb-top-100000.txt text eol=lf -diff
