# 릴리스 서명 정보 — 이 파일을 같은 폴더에 keystore.properties 로 복사해 실제 값을 채운다.
#
# keystore.properties 와 .jks 파일은 .gitignore 대상이다. 저장소·노션·메신저에 올리지 않는다.
# 키스토어 파일과 비밀번호를 잃으면 이 앱을 다시는 업데이트할 수 없으므로 각자 백업한다.
#
# 이 파일이 없으면 릴리스 빌드는 서명 없이 만들어진다. 서명 없는 AAB 는 플레이에 올릴 수 없다.

# 키스토어 파일의 절대 경로. 역슬래시 대신 슬래시를 쓴다.
storeFile=C:/Users/<사용자>/keystore/meonggo-upload.jks

# 키스토어를 만들 때 정한 비밀번호
storePassword=

# 키를 만들 때 지정한 alias
keyAlias=meonggo

# 키 비밀번호. 키스토어 비밀번호와 같게 만들었다면 같은 값을 넣는다.
keyPassword=
