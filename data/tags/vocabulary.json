{
  "vocab_version": "tags-v1",
  "status": "PROPOSAL — 태그 원천 변경(CLIP 사진 추론 보류 → 사용자 입력 + 공공 API 필드 정규화)은 팀 합의 대기. 어휘·매핑 자체는 실데이터(2024-01~2026-09 공공 수집분 257,190건) 기반 초안",
  "evidence": "data/experiments/2026-09-09-tag-vocabulary/",
  "tag_format": "<attribute>:<code> — 자카드 집합 원소. 스키마는 jaccard-input.schema.json",
  "normalization_rules": {
    "common": [
      "1) '기타(...)' 래퍼 제거: '기타(흰색)' → '흰색'",
      "2) 복합 표기 분리: 구분자 [,&+/·.] 및 공백으로 토큰 분할",
      "3) 토큰 정규화: 공백·구두점([\\s·\\-()\\[\\]]) 제거",
      "4) 정규화 토큰을 label·aliases(같은 정규화 적용)와 대조해 codes로 치환 — 복합 단일 토큰(예: '흑백')은 여러 코드로 확장",
      "5) color.ignore_tokens(수식어·서술어 — '옅은', '바탕에' 등)는 색 정보가 없으므로 매핑 실패로 세지 않고 버린다",
      "6) 매핑 실패 토큰·'모름'·결측은 태그 생략(집합 미포함)하고 생성기가 unmapped 로그로 남긴다 — 공통 '미상' 토큰은 자카드 가짜 유사도를 만들기 때문"
    ],
    "weight_to_size": "공공 weight '3.2(Kg)' → 선두 숫자 파싱(kg) → small <8 / medium 8~20 / large ≥20. 파싱 실패(전체의 0.02%)는 태그 생략"
  },
